<Window x:Class="TaskbarHeroOverlay.UI.Windows.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <TabControl>
            <TabItem Header="Screen">
                <StackPanel Margin="16">
                    <TextBlock Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Foreground="#555555"
                               Text="Use edit mode to move and resize the game window directly on-screen. The red frame works like a photo editor crop box, and the game window will never shrink below 640x480." />
                    <Button x:Name="EditModeButton"
                            Width="140"
                            Height="36"
                            HorizontalAlignment="Left"
                            Click="EditModeClicked">Edit Screen</Button>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
