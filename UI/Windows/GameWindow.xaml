<Window x:Class="TaskbarHeroOverlay.UI.Windows.GameWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
         WindowStyle="None"
         ResizeMode="NoResize"
         AllowsTransparency="True"
         Background="Transparent"
         ShowInTaskbar="False"
         ShowActivated="False"
         Topmost="True"
         Left="0"
         Top="0">
    <Window.Resources>
        <Style x:Key="HandleStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Ellipse Fill="#FF2F2F" Stroke="White" StrokeThickness="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                IsHitTestVisible="False">
            <StackPanel x:Name="Hero"
                        Width="64"
                        Height="92">
                <TextBlock Text="Taskbar Hero"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,6" />
                <Grid Width="56" Height="82" HorizontalAlignment="Center">
                    <Border Width="56"
                            Height="72"
                            CornerRadius="14"
                            Background="#7C5CFF"
                            VerticalAlignment="Top" />
                    <Border Width="36"
                            Height="18"
                            CornerRadius="8"
                            Background="#D9F0FF"
                            Margin="10,14,10,0"
                            VerticalAlignment="Top" />
                    <Border Width="16"
                            Height="10"
                            CornerRadius="5"
                            Background="#3D2A82"
                            Margin="8,72,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />
                    <Border Width="16"
                            Height="10"
                            CornerRadius="5"
                            Background="#3D2A82"
                            Margin="0,72,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top" />
                </Grid>
            </StackPanel>
        </Canvas>
        <Grid x:Name="EditorChrome"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <primitives:Thumb x:Name="MoveThumb"
                              Margin="8"
                              Background="Transparent"
                              Cursor="SizeAll"
                              DragDelta="MoveThumb_OnDragDelta" />
            <Border Margin="8"
                    BorderBrush="#FF2F2F"
                    BorderThickness="2"
                    CornerRadius="4" />
            <primitives:Thumb Style="{StaticResource HandleStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1" Cursor="SizeNWSE" DragDelta="TopLeftThumb_OnDragDelta" />
            <primitives:Thumb Style="{StaticResource HandleStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" Cursor="SizeNS" DragDelta="TopThumb_OnDragDelta" />
            <primitives:Thumb Style="{StaticResource HandleStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" Cursor="SizeNESW" DragDelta="TopRightThumb_OnDragDelta" />
            <primitives:Thumb Style="{StaticResource HandleStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" Cursor="SizeWE" DragDelta="LeftThumb_OnDragDelta" />
            <primitives:Thumb Style="{StaticResource HandleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" Cursor="SizeWE" DragDelta="RightThumb_OnDragDelta" />
            <primitives:Thumb Style="{StaticResource HandleStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1" Cursor="SizeNESW" DragDelta="BottomLeftThumb_OnDragDelta" />
            <primitives:Thumb Style="{StaticResource HandleStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Cursor="SizeNS" DragDelta="BottomThumb_OnDragDelta" />
            <primitives:Thumb Style="{StaticResource HandleStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" Cursor="SizeNWSE" DragDelta="BottomRightThumb_OnDragDelta" />
        </Grid>
    </Grid>
</Window>
